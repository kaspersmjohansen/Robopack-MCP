# Lists the environment variables the server reads. The server does not load this file itself:
# set them in your MCP client config (the "env" block) or in your shell. Never commit a real key.
# The key is shown only once in Robopack under Settings -> API Integration.
ROBOPACK_API_KEY=
# test (default) or prod
ROBOPACK_ENV=test
# Where upload_package_file may read from, and where download_package writes to
ROBOPACK_UPLOAD_DIR=./robopack-uploads
ROBOPACK_DOWNLOAD_DIR=./robopack-downloads
